<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Testcontainers.Keycloak" />
    <PackageReference Include="Testcontainers.MongoDb" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- Gerador de [LoggerMessage] que aplica [PersonalData], como o dos módulos. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hosts/Api/Api.csproj" Aliases="ApiHost" />
    <ProjectReference Include="../../src/Hosts/Worker/Worker.csproj" Aliases="WorkerHost" />
    <!-- Executado como processo real; o teste só precisa que ele esteja compilado. -->
    <ProjectReference Include="../../src/Hosts/Migrator/Migrator.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
