{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/assets/stryker-config.schema.json",
  "stryker-config": {
    "solution": "tests/Ledger.UnitTests/Ledger.Mutation.slnx",
    "project": "Ledger.csproj",
    "test-projects": [
      "tests/Ledger.UnitTests/Ledger.UnitTests.csproj"
    ],
    "mutate": [
      "**/Domain/**/*.cs"
    ],
    "reporters": [
      "progress",
      "cleartext",
      "html"
    ],
    "thresholds": {
      "high": 90,
      "low": 80,
      "break": 80
    },
    "test-runner": "mtp"
  }
}
