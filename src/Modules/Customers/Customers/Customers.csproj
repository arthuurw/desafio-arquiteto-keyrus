<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Mediator.Abstractions" />
    <!-- O gerador de [LoggerMessage] deste pacote é o que aplica a classificação [PersonalData]; o padrão a ignora. -->
    <PackageReference Include="Microsoft.Extensions.Telemetry.Abstractions" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Customers.Contracts/Customers.Contracts.csproj" />
    <ProjectReference Include="../../../BuildingBlocks/BuildingBlocks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Customers.UnitTests" />
    <!-- Os testes de integração leem o banco e o cofre com os tipos do módulo, como a cifra e os nomes de campo. -->
    <InternalsVisibleTo Include="IntegrationTests" />
  </ItemGroup>
</Project>
